# Django settings
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=.alwaysdata.net,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://*.alwaysdata.net,https://yourdomain.com

# Database (Alwaysdata PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/yourdb

# Email (for error reporting)
ADMIN_EMAIL=you@example.com
SERVER_EMAIL=noreply@yourdomain.com

# Cloudinary (media file storage — sign up free at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security (optional overrides)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
