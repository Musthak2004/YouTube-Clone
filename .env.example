# =============================================================================
# Django Project — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control — it is listed in .gitignore.
# =============================================================================

# ── Django Core ──────────────────────────────────────────────────────────────
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme

# Set to True for local dev, False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (local file-based, no extra config needed).
# For production (PythonAnywhere MySQL / PostgreSQL), use a database URL:
#   SQLite:  sqlite:///path/to/db.sqlite3
#   MySQL:   mysql://user:pass@host/dbname
#   Postgres: postgres://user:pass@host/dbname
# Leave blank to use the default SQLite database defined in settings.py.
DATABASE_URL=

# ── Email (password reset, notifications) ────────────────────────────────────
# Optional — only needed if you enable email features.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=changeme@gmail.com
EMAIL_HOST_PASSWORD=changeme
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=changeme@gmail.com

# ── Sentry (optional) ────────────────────────────────────────────────────────
# https://sentry.io — uncomment and set your DSN to enable error tracking.
# SENTRY_DSN=https://key@oXXXX.ingest.sentry.io/project
